{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gecompat/SQL_Server_Toolbelt/blob/main/Modules/toolbelt.tsql.ssis-debug/Contracts/ComponentsV2.schema.json",
  "title": "SSIS debug current profile help overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "baseContract", "operation", "bindingProfile", "projectContext", "catalogBindings", "help"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "ssis-debug-current"},
    "baseContract": {"const": "Contracts/Api.json"},
    "operation": {"const": "bindings-template"},
    "bindingProfile": {"const": "ssis-debug-components-v2"},
    "projectContext": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "resourceOptionsAllowed"],
      "properties": {"schemaVersion": {"const": 2}, "resourceOptionsAllowed": {"const": false}}
    },
    "catalogBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "extension", "fileAccess", "sqlTextFields"],
      "properties": {"schemaVersion": {"const": 2}, "extension": {"const": "flatFileInputs"}, "fileAccess": {"const": false}, "sqlTextFields": {"const": false}}
    },
    "help": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section", "ordinal", "description"],
        "properties": {
          "section": {"enum": ["DESCRIPTION", "EXAMPLE", "LIMITATION"]},
          "ordinal": {"type": "integer", "minimum": 1},
          "description": {"type": "string", "minLength": 1, "maxLength": 4000},
          "exampleSql": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "allOf": [{"if": {"properties": {"section": {"const": "EXAMPLE"}}}, "then": {"required": ["exampleSql"]}}, {"if": {"properties": {"section": {"const": "EXAMPLE"}}}, "else": {"not": {"required": ["exampleSql"]}}}]
      }
    }
  }
}
