{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gecompat/SQL_Server_Toolbelt/blob/main/Modules/toolbelt.tsql.ssis-debug/Contracts/Exchange/SSIS_Object_Identities_V1_2.schema.json",
  "title": "SSIS execution scope identities 1.2.0",
  "$comment": "Companion to approved exchange artifact urn:uuid:01a16fd0-76d2-763d-aea4-b034dd939d3b. Native DTSID alone proves neither revision nor execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "identityProfile",
    "packageSha256",
    "objects"
  ],
  "properties": {
    "contract": {
      "const": "ssis-object-identities"
    },
    "version": {
      "const": "1.2.0"
    },
    "identityProfile": {
      "const": "document-order-v1"
    },
    "packageSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "nodeKind",
          "dtsId",
          "packagePath",
          "parentId",
          "scopeKind",
          "eventName",
          "callTarget",
          "steps",
          "profileStatus"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^(pkg|exe)[1-9][0-9]{0,7}$",
            "maxLength": 128
          },
          "nodeKind": {
            "enum": [
              "PACKAGE",
              "EXECUTABLE"
            ]
          },
          "dtsId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "packagePath": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "scopeKind": {
            "enum": [
              "PACKAGE",
              "CALL",
              "LOOP",
              "HANDLER",
              "EXECUTABLE"
            ]
          },
          "eventName": {
            "enum": [
              null,
              "OnPreExecute",
              "OnPostExecute",
              "OnError"
            ]
          },
          "callTarget": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 260
          },
          "steps": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "counter"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "counter": {
                  "type": "boolean"
                }
              }
            }
          },
          "profileStatus": {
            "enum": [
              "SUPPORTED",
              "UNQUALIFIED"
            ]
          }
        }
      }
    }
  }
}
