{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gecompat/SQL_Server_Toolbelt/blob/main/Modules/toolbelt.tsql.ssis-debug/Contracts/Exchange/SSIS_Object_Identities_V1.schema.json",
  "title": "SSIS object identities 1.0.0",
  "$comment": "Companion to approved exchange artifact urn:uuid:01a16fd0-76d2-763d-aea4-b034dd939d3b. Native DTSID alone proves neither revision nor execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "identityProfile",
    "packageSha256",
    "objects"
  ],
  "properties": {
    "contract": {
      "const": "ssis-object-identities"
    },
    "version": {
      "const": "1.0.0"
    },
    "identityProfile": {
      "const": "document-order-v1"
    },
    "packageSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "nodeKind",
          "dtsId",
          "packagePath"
        ],
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^(pkg|exe)[1-9][0-9]{0,7}$",
            "maxLength": 128
          },
          "nodeKind": {
            "enum": [
              "PACKAGE",
              "EXECUTABLE"
            ]
          },
          "dtsId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "packagePath": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4000
          }
        }
      }
    }
  }
}
