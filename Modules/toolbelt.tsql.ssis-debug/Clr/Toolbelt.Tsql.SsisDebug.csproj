<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <OutputType>Library</OutputType>
    <RootNamespace>Toolbelt.Tsql.SsisDebug</RootNamespace>
    <AssemblyName>Toolbelt.Tsql.SsisDebug</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Data" />
    <Reference Include="System.Xml" /><Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.SqlServer.TransactSql.ScriptDom"><HintPath>$(ScriptDomDllPath)</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="..\Exchange\Core\*.cs"><Link>SharedExchange\%(Filename)%(Extension)</Link></Compile>
    <Compile Include="..\..\toolbelt.tsql.script-parser\Clr\PreparseGuardCore.cs"><Link>Shared\PreparseGuardCore.cs</Link></Compile>
  </ItemGroup>
  <Target Name="RequireExplicitScriptDom" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ScriptDomDllPath)')" Text="Explicit pinned ScriptDomDllPath required." />
    <GetFileHash Files="$(ScriptDomDllPath)" Algorithm="SHA512"><Output TaskParameter="Items" ItemName="PinnedScriptDom" /></GetFileHash>
    <Error Condition="'%(PinnedScriptDom.FileHash)' != '459E137268A4CA378023CD7E68A04655CEC2C19A8D01546E81B1A7ABF1FE2F9226A03CC3FA2323081C3C1B05626AF988C98527711D577919CF409367F853DAC7'" Text="ScriptDom pin mismatch." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
