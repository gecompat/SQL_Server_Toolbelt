<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{B1F8C9E2-7D3A-4F5E-9B2C-1A6E8D4F0C3B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Toolbelt.Tsql.ScriptParser</RootNamespace>
    <AssemblyName>Toolbelt.Tsql.ScriptParser</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.SqlServer.TransactSql.ScriptDom">
      <HintPath>$(ScriptDomDllPath)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="ScriptParserProvider.cs" />
    <Compile Include="PreparseGuard.cs" />
  </ItemGroup>
  <Target Name="RequireExplicitScriptDom" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ScriptDomDllPath)')" Text="Explicit pinned ScriptDomDllPath required." />
    <GetFileHash Files="$(ScriptDomDllPath)" Algorithm="SHA512">
      <Output TaskParameter="Items" ItemName="PinnedScriptDom" />
    </GetFileHash>
    <Error Condition="'%(PinnedScriptDom.FileHash)' != '459E137268A4CA378023CD7E68A04655CEC2C19A8D01546E81B1A7ABF1FE2F9226A03CC3FA2323081C3C1B05626AF988C98527711D577919CF409367F853DAC7'" Text="ScriptDom pin mismatch." />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
